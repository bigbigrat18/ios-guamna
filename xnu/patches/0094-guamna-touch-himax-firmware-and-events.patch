+/*
+ * DSI DCS commands (drivers/gpu/drm/msm/dsi/dsi_host.c, 6G layout: registers
+ * at ctrl base + 4). HX83102D must have its touch firmware in SRAM before
+ * the panel leaves sleep (Motorola reloads it on DRM_PANEL_EARLY_EVENT_BLANK,
+ * before the on-commands 0x11 / 0x29 of dsi-panel-moto-hx83102d-hlt-hdplus-
+ * video.dtsi). ABL woke the panel without it, so: display off, sleep in,
+ * upload, sleep out, display on. The one-word command buffer sits in the
+ * unused tail of the boot framebuffer carve-out, which MDSS already reads.
+ */
+#define DSI_PA          0x05e94000u
+#define DSI_CTRL        (4u + 0x000u)
+#define DSI_STATUS0     (4u + 0x004u)
+#define DSI_CMD_DMA     (4u + 0x038u)
+#define DSI_DMA_BASE    (4u + 0x044u)
+#define DSI_DMA_LEN     (4u + 0x048u)
+#define DSI_TRIG_CTRL   (4u + 0x080u)
+#define DSI_TRIG_DMA    (4u + 0x08cu)
+#define DSI_INTR_CTRL   (4u + 0x10cu)
+#define DSI_CMDBUF_PA   0x5ce00000u     /* fb carve-out 0x5c000000 + 15 MiB, offset 14 MiB */
+
+static vm_offset_t dsi_regs, dsi_buf;
+
+static int
+dsi_dcs(uint8_t cmd)
+{
+	if (!dsi_regs) {
+		dsi_regs = ml_io_map(DSI_PA, 0x1000);
+		dsi_buf = ml_io_map(DSI_CMDBUF_PA, 0x1000);
+		if (!dsi_regs || !dsi_buf) {
+			return ENXIO;
+		}
+		printf("GUAMNA DSI: ctrl %#x status %#x cmd_dma %#x trig %#x intr %#x\n",
+		    rd(dsi_regs, DSI_CTRL), rd(dsi_regs, DSI_STATUS0), rd(dsi_regs, DSI_CMD_DMA),
+		    rd(dsi_regs, DSI_TRIG_CTRL), rd(dsi_regs, DSI_INTR_CTRL));
+	}
+	/* MSM in-memory packet: DCS short write, no parameter (type 0x05), last */
+	wr(dsi_buf, 0, (uint32_t)cmd | (0x05u << 16) | (0x80u << 24));
+	uint32_t ctrl = rd(dsi_regs, DSI_CTRL);
+	uint32_t trig = rd(dsi_regs, DSI_TRIG_CTRL);
+	wr(dsi_regs, DSI_TRIG_CTRL, (trig & ~7u) | 4u | (1u << 12));       /* SW trigger, block within frame */
+	wr(dsi_regs, DSI_CMD_DMA, rd(dsi_regs, DSI_CMD_DMA) | (1u << 26));  /* LP, like the panel's on-commands */
+	wr(dsi_regs, DSI_CTRL, ctrl | (1u << 2) | 1u);                      /* CMD_MODE_EN | ENABLE */
+	wr(dsi_regs, DSI_INTR_CTRL, rd(dsi_regs, DSI_INTR_CTRL) | 1u);      /* clear CMD_DMA_DONE */
+	wr(dsi_regs, DSI_DMA_BASE, DSI_CMDBUF_PA);
+	wr(dsi_regs, DSI_DMA_LEN, 4);
+	wr(dsi_regs, DSI_TRIG_DMA, 1);
+	int err = ETIMEDOUT;
+	for (int i = 0; i < 200; i++) {
+		gt_sleep(1);
+		/* done: CMD_DMA_DONE latched, or the DMA engine is no longer busy */
+		if ((rd(dsi_regs, DSI_INTR_CTRL) & 1u) || (i >= 2 && !(rd(dsi_regs, DSI_STATUS0) & 2u))) {
+			err = 0;
+			break;
+		}
+	}
+	uint32_t st = rd(dsi_regs, DSI_STATUS0);
+	wr(dsi_regs, DSI_INTR_CTRL, rd(dsi_regs, DSI_INTR_CTRL) | 1u);
+	wr(dsi_regs, DSI_CTRL, ctrl);
+	wr(dsi_regs, DSI_TRIG_CTRL, trig);
+	printf("GUAMNA DSI: DCS %#04x %s (status %#x)\n", cmd, err ? "TIMEOUT" : "sent", st);
+	sum("dcs %02x %d", cmd, err);
+	return err;
+}
