+static uint8_t hx_cfg[0x4000];
+
+/* himax_mcu_firmware_update_0f + himax_zf_part_info (HX83102D, code overlay) */
+static bool
+hx_upload(const uint8_t *fw, unsigned fwlen)
+{
+	const uint8_t *tab = fw + 0x10000;
+	unsigned parts = tab[12];
+	uint32_t base = 0xffffffffu, top = 0;
+	unsigned top_sz = 0;
+	int border = -1;
+
+	if (parts < 2 || parts > 32 || 0x10000 + parts * 16 > fwlen) {
+		sum("bad part table %u", parts);
+		return false;
+	}
+	(void)hx_reg_write32(0x90000018u, 0x55);                /* system reset */
+	if (!hx_sense_off()) {
+		return false;
+	}
+	memset(hx_cfg, 0, sizeof(hx_cfg));
+	for (unsigned pass = 0; pass < 2; pass++) {
+		for (unsigned i = 1; i < parts; i++) {
+			const uint8_t *e = tab + i * 16;
+			uint32_t sram = (uint32_t)e[0] | (uint32_t)e[1] << 8 | (uint32_t)e[2] << 16 | (uint32_t)e[3] << 24;
+			uint32_t sz = (uint32_t)e[4] | (uint32_t)e[5] << 8 | (uint32_t)e[6] << 16 | (uint32_t)e[7] << 24;
+			uint32_t off = (uint32_t)e[8] | (uint32_t)e[9] << 8 | (uint32_t)e[10] << 16 | (uint32_t)e[11] << 24;
+			bool ovl = (e[15] == 0x55 && e[14] == 0x66) || sram == 0x20008ce0u;
+			if (ovl) {
+				if (pass == 0 && e[15] == 0x55 && e[14] == 0x66 && e[13] == 2) {
+					border = (int)i;
+				}
+				continue;
+			}
+			if (off + sz > fwlen) {
+				sum("part %u out of file", i);
+				return false;
+			}
+			if (pass == 0) {
+				if (sram < base) {
+					base = sram;
+				}
+				if (sram >= top) {
+					top = sram;
+					top_sz = sz;
+				}
+			} else {
+				uint32_t a = sram & ~3u;
+				if (a < base || a - base + sz > sizeof(hx_cfg)) {
+					sum("cfg part %u too big", i);
+					return false;
+				}
+				memcpy(hx_cfg + (a - base), fw + off, sz);
+			}
+		}
+	}
+	unsigned cfg_sz = top - base + top_sz;
+	cfg_sz = (cfg_sz + 15u) & ~15u;
+	if (cfg_sz > sizeof(hx_cfg)) {
+		sum("cfg %u too big", cfg_sz);
+		return false;
+	}
+	/* part 0: main code, its CRC over itself is 0 */
+	const uint8_t *e0 = tab;
+	uint32_t sram0 = (uint32_t)e0[0] | (uint32_t)e0[1] << 8 | (uint32_t)e0[2] << 16 | (uint32_t)e0[3] << 24;
+	uint32_t sz0 = (uint32_t)e0[4] | (uint32_t)e0[5] << 8 | (uint32_t)e0[6] << 16 | (uint32_t)e0[7] << 24;
+	uint32_t off0 = (uint32_t)e0[8] | (uint32_t)e0[9] << 8 | (uint32_t)e0[10] << 16 | (uint32_t)e0[11] << 24;
+	printf("GUAMNA TOUCH: fw %u bytes, %u parts, main %u at %#x, cfg %u at %#x, border part %d\n",
+	    fwlen, parts, sz0, sram0, cfg_sz, base, border);
+	sum("parts %u main %u cfg %u border %d", parts, sz0, cfg_sz, border);
+	if (off0 + sz0 > fwlen || !hx_write_crc(sram0, fw + off0, sz0, 0, "main")) {
+		return false;
+	}
+	if (!hx_write_crc(base, hx_cfg, cfg_sz, hx_sw_crc(hx_cfg, cfg_sz), "cfg")) {
+		return false;
+	}
+	uint8_t reply = 0x66;                                   /* ovl_border_reply */
+	if (border > 0) {
+		const uint8_t *e = tab + border * 16;
+		uint32_t sram = (uint32_t)e[0] | (uint32_t)e[1] << 8 | (uint32_t)e[2] << 16 | (uint32_t)e[3] << 24;
+		uint32_t sz = (uint32_t)e[4] | (uint32_t)e[5] << 8 | (uint32_t)e[6] << 16 | (uint32_t)e[7] << 24;
+		uint32_t off = (uint32_t)e[8] | (uint32_t)e[9] << 8 | (uint32_t)e[10] << 16 | (uint32_t)e[11] << 24;
+		if (!sz || off + sz > fwlen || !hx_write_crc(sram, fw + off, sz, 0, "border")) {
+			reply = 0xff;                           /* ovl_fault */
+		}
+	} else {
+		reply = 0xff;
+	}
+	for (int i = 0; i < 5; i++) {
+		int err = 0;
+		(void)hx_reg_write32(0x10007ffcu, reply);       /* overlay handshake */
+		if (hx_reg_read32(0x10007ffcu, &err) == reply) {
+			break;
+		}
+	}
+	{
+		int e = 0;
+		printf("GUAMNA TOUCH: before: raw_out_sel %#x sorting %#x mode %#x\n",
+		    hx_reg_read32(0x800204f4u, &e), hx_reg_read32(0x10007f04u, &e), hx_reg_read32(0x10007088u, &e));
+	}
+	/* vendor himax_mcu_power_on_init: raw-out select and sorting (test) mode off */
+	(void)hx_reg_write32(0x800204f4u, 0);                   /* hx83102d raw_out_sel */
+	(void)hx_reg_write32(0x10007f04u, 0);                   /* sorting_mode_en */
+	(void)hx_reg_write32(0x10007294u, 1);                   /* set frame */
+	(void)hx_reg_write32(0x10007f00u, 0);                   /* flash reload enable (vendor reload_disable(0)) */
+	return hx_sense_on();
+}
