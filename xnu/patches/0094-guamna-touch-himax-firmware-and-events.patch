+/* Hardware CRC of an SRAM range (vendor himax_mcu_check_CRC). */
+static uint32_t
+hx_hw_crc(uint32_t addr, unsigned len)
+{
+	unsigned words = len / 4;
+	int err = hx_reg_write32(0x80050020u, addr);
+	if (!err) {
+		err = hx_reg_write32(0x80050028u, 0x00990000u | (words & 0xffffu));
+	}
+	for (int i = 0; !err && i < 100; i++) {
+		uint32_t st = hx_reg_read32(0x80050000u, &err);
+		if (!(st & 1u)) {
+			return hx_reg_read32(0x80050018u, &err);
+		}
+		gt_sleep(1);
+	}
+	return 0xffffffffu;     /* never a valid answer below */
+}
+
+/* Software CRC (vendor himax_mcu_Calculate_CRC_with_AP). */
+static uint32_t
+hx_sw_crc(const uint8_t *p, unsigned len)
+{
+	uint32_t crc = 0xffffffffu;
+	for (unsigned i = 0; i + 4 <= len; i += 4) {
+		uint32_t w = (uint32_t)p[i] | (uint32_t)p[i + 1] << 8 | (uint32_t)p[i + 2] << 16 | (uint32_t)p[i + 3] << 24;
+		crc ^= w;
+		for (int j = 0; j < 32; j++) {
+			crc = (crc & 1u) ? ((crc >> 1) & 0x7fffffffu) ^ 0x82f63b78u : (crc >> 1) & 0x7fffffffu;
+		}
 	}
-	v = 0x00;
-	if ((err = hx_write(0x0c, &v, 1))) {
-		return err;
+	return crc;
+}
+
+/* Write a part and check the hardware CRC (0 = image carries its own CRC). */
+static bool
+hx_write_crc(uint32_t addr, const uint8_t *data, unsigned len, uint32_t want, const char *what)
+{
+	uint32_t crc = 0;
+	for (int retry = 0; retry < 3; retry++) {
+		if (hx_reg_write(addr, data, len)) {
+			continue;
+		}
+		crc = hx_hw_crc(addr, len);
+		if (crc == want) {
+			printf("GUAMNA TOUCH: %s %u bytes at %#x CRC ok\n", what, len, addr);
+			return true;
+		}
+	}
+	printf("GUAMNA TOUCH: %s CRC fail hw %#x want %#x\n", what, crc, want);
+	sum("%s crc %#x/%#x", what, crc, want);
+	return false;
+}
