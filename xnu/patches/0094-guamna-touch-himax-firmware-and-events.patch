+/* AHB register / SRAM write (vendor himax_mcu_register_write), chunked. */
+static int
+hx_reg_write(uint32_t addr, const uint8_t *data, unsigned n)
+{
+	static uint8_t buf[HX_CHUNK + 4];
+	int err = hx_burst(n > 4);
+	for (unsigned done = 0; !err && done < n;) {
+		unsigned c = n - done > HX_CHUNK ? HX_CHUNK : n - done;
+		uint32_t a = addr + done;
+		buf[0] = (uint8_t)a;
+		buf[1] = (uint8_t)(a >> 8);
+		buf[2] = (uint8_t)(a >> 16);
+		buf[3] = (uint8_t)(a >> 24);
+		memcpy(buf + 4, data + done, c);
+		err = hx_write(0x00, buf, c + 4);
+		done += c;
+		delay(100);
 	}
-	if ((err = hx_write(0x00, a, 4))) {
-		return err;
+	return err;
+}
