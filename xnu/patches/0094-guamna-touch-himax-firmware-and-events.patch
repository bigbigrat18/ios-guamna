+/* Panel (720x1600) -> sweet_hid_touch coordinates (1080x2400 panel inside 1125x2436). */
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+static void
+gt_report(int id, bool down, int px, int py)
+{
+	/* AppleCLCD shows the 1125x2436 canvas as 720x1559 at y 20 (0092). */
+	int lx = px * 1125 / 720;
+	int ly = (py - 20) * 2436 / 1559;
+	sweet_hid_touch(id, down ? 1 : 0, lx - (1125 - 1080) / 2, ly - (2436 - 2400) / 2);
+}
+
+#define HX_MAX_PT       10
+#define HX_INFO_SZ      56      /* (10 + 2 + 2) * 4 */
+#define HX_PT_CNT       52      /* 10 * 4 coords + 12 area */
+
+static void
+gt_events(void)
+{
+	uint8_t buf[HX_INFO_SZ];
+	int x[HX_MAX_PT] = { 0 }, y[HX_MAX_PT] = { 0 };
+	uint32_t active = 0;
+	unsigned logged = 0, errors = 0, dumped = 0, bad = 0;
+	int touchlog = 0, nohid = 0;
+	uint64_t next_log = 0;
+	(void)PE_parse_boot_argn("guamnatouchlog", &touchlog, sizeof(touchlog));
+	(void)PE_parse_boot_argn("guamnatouchnohid", &nohid, sizeof(nohid));
+
+	for (;;) {
+		bool irq = !(rd(gt.tlmm, GT_PIN_IRQ * 0x1000u + 4u) & 1u);   /* INT is active low */
+		if (!irq && !active) {
+			gt_sleep(8);
+			continue;
+		}
+		int err = hx_write1(0x11, 0x00);                        /* AHB burst read off */
+		if (!err) {
+			err = hx_read(0x30, buf, sizeof(buf));
+		}
+		(void)hx_write1(0x11, 0x01);
+		if (err) {
+			if (errors++ < 5) {
+				printf("GUAMNA TOUCH: event read err %d\n", err);
