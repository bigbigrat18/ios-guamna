+static void
+gt_reset_pulse(void)
+{
+	uint32_t io = GT_PIN_RST * 0x1000u + 4u;
+	wr(gt.tlmm, io, rd(gt.tlmm, io) & ~2u);
+	gt_sleep(20);
+	wr(gt.tlmm, io, rd(gt.tlmm, io) | 2u);
+	gt_sleep(50);
+}
+
+/* hx83102d_sense_off(false): stop the touch MCU, enter safe mode, reset TCON/ADC. */
+static bool
+hx_sense_off(void)
+{
+	int err = 0;
+	(void)hx_reg_write32(0x9000005cu, 0xa5);                /* fw stop */
+	gt_sleep(10);
+	(void)hx_reg_read32(0x900000a8u, &err);
+	for (int cnt = 0; cnt <= 5; cnt++) {
+		(void)hx_write1(0x31, 0x27);                    /* safe-mode password */
+		(void)hx_write1(0x32, 0x95);
+		uint32_t st = hx_reg_read32(0x900000a8u, &err);
+		if ((st & 0xff) == 0x0c) {
+			(void)hx_reg_write32(0x80020020u, 0);   /* reset TCON */
+			gt_sleep(1);
+			(void)hx_reg_write32(0x80020020u, 1);
+			(void)hx_reg_write32(0x80020094u, 0);   /* reset ADC */
+			gt_sleep(1);
+			(void)hx_reg_write32(0x80020094u, 1);
+			return true;
+		}
+		printf("GUAMNA TOUCH: sense off: state %#x, retry %d\n", st, cnt);
+		gt_sleep(5);
+		gt_reset_pulse();
+	}
+	sum("sense off fail");
+	return false;
+}
+
+/* hx83102d_sense_on(0): interface on, clear fw stop, reset, reload to active. */
+static bool
+hx_sense_on(void)
+{
+	uint8_t d[4];
+	int err = 0;
+	(void)hx_read(0x08, d, 4);                              /* knock */
+	for (int i = 0; i < 10; i++) {
+		uint8_t a = 0, b = 0;
+		(void)hx_burst(false);
+		(void)hx_read(0x13, &a, 1);
+		(void)hx_read(0x0d, &b, 1);
+		if (a == 0x31 && b == 0x10) {
+			break;
+		}
+		gt_sleep(1);
+	}
+	(void)hx_reg_write32(0x9000005cu, 0);
+	gt_sleep(10);
+	gt_reset_pulse();
+	for (int i = 0; i < 5; i++) {
+		(void)hx_reg_write32(0x90000048u, 0xec);
+		gt_sleep(1);
+		uint32_t v = hx_reg_read32(0x90000048u, &err);
+		if ((v & 0xffff) == 0x01ec) {
+			return true;
+		}
+	}
+	sum("reload to active fail");
+	return false;
+}
