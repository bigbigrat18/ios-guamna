+static const uint8_t *
+gt_firmware(unsigned *len)
+{
+	DTEntry node;
+	void const *p = NULL;
+	unsigned int size = 0;
+	if (SecureDTLookupEntry(NULL, "/guamna-touch", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "firmware", &p, &size) != kSuccess || size < 0x10100) {
+		return NULL;
+	}
+	*len = size;
+	return (const uint8_t *)p;
+}
