+/* Ack sdhci-msm power IRQs (bus on/off, IO level) the way Linux does, polled. */
+static uint32_t
+msm_pwr_ack(uint64_t wait_ns)
+{
+	uint64_t dl = deadline_in(wait_ns);
+	uint32_t st;
+
+	while (!((st = rd32(MSM_PWRCTL_STATUS) & 0xf)) && !timed_out(dl)) {
+		delay(10);
+	}
+	if (!st) {
+		return 0;
+	}
+	for (int retry = 10; retry > 0; retry--) {
+		wr32(MSM_PWRCTL_CLEAR, st);
+		if (!(rd32(MSM_PWRCTL_STATUS) & st)) {
+			break;
+		}
+		delay(10);
+	}
+	uint32_t ack = 0;
+	if (st & (MSM_PWR_BUS_ON | MSM_PWR_BUS_OFF)) {
+		ack |= MSM_PWR_BUS_SUCCESS;
+	}
+	if (st & (MSM_PWR_BUS_ON | MSM_PWR_BUS_OFF | MSM_PWR_IO_LOW | MSM_PWR_IO_HIGH)) {
+		ack |= MSM_PWR_IO_SUCCESS;
+	}
+	wr32(MSM_PWRCTL_CTL, ack);
+	/* eMMC VCCQ is 1.8 V only: keep the pads at 1.8 V whatever was asked. */
+	wr32(MSM_VENDOR_SPEC, rd32(MSM_VENDOR_SPEC) | MSM_IO_PAD_SWITCH_EN | MSM_IO_PAD_SWITCH);
+	return st;
+}
