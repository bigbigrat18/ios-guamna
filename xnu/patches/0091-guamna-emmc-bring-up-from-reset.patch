+/* GCC SDCC1 clocks: branches on, root rate (programs 50 MHz if the root is off). */
+static uint32_t
+gcc_sdcc1_rate(void)
+{
+	uint32_t cfg = gcc_rd(GCC_SDCC1_RCG_CFG);
+	uint32_t src = (cfg >> 8) & 7, hid = cfg & 0x1f, mode = (cfg >> 12) & 3;
+	uint64_t parent;
+
+	switch (src) {
+	case 0: parent = 19200000; break;       /* bi_tcxo */
+	case 1: parent = 600000000; break;      /* gpll0_out_early */
+	case 2: parent = 300000000; break;      /* gpll0_out_aux2 */
+	case 4: parent = 384000000; break;      /* gpll6_out_main */
+	default: return 0;
+	}
+	uint64_t rate = hid ? parent * 2 / (hid + 1) : parent;
+	if (mode) {
+		uint32_t m = gcc_rd(GCC_SDCC1_RCG_M) & 0xff;
+		uint32_t n = ((~gcc_rd(GCC_SDCC1_RCG_N)) & 0xff) + m;
+		if (!m || !n) {
+			return 0;
+		}
+		rate = rate * m / n;
+	}
+	return (uint32_t)rate;
+}
+
+static int
+gcc_sdcc1_on(void)
+{
+	uint32_t cmd = gcc_rd(GCC_SDCC1_RCG_CMD), cfg = gcc_rd(GCC_SDCC1_RCG_CFG);
+	uint32_t apps = gcc_rd(GCC_SDCC1_APPS_CBCR), ahb = gcc_rd(GCC_SDCC1_AHB_CBCR);
+
+	diag("gcc rcg 0x%x/0x%x apps 0x%x ahb 0x%x", cmd, cfg, apps, ahb);
+	if ((cmd & RCG_ROOT_OFF) || gcc_sdcc1_rate() == 0) {
+		/* 50 MHz: gpll0_out_aux2 (300 MHz) / 6, no M/N, like Linux's table */
+		gcc_wr(GCC_SDCC1_RCG_CFG, (2u << 8) | (2 * 6 - 1));
+		gcc_wr(GCC_SDCC1_RCG_CMD, gcc_rd(GCC_SDCC1_RCG_CMD) | RCG_UPDATE);
+		uint64_t dl = deadline_in(10 * NSEC_PER_MSEC);
+		while ((gcc_rd(GCC_SDCC1_RCG_CMD) & RCG_UPDATE) && !timed_out(dl)) {
+			delay(1);
+		}
+		diag("rcg -> 50MHz cmd 0x%x", gcc_rd(GCC_SDCC1_RCG_CMD));
+	}
+	gcc_wr(GCC_SDCC1_AHB_CBCR, gcc_rd(GCC_SDCC1_AHB_CBCR) | 1);
+	gcc_wr(GCC_SDCC1_APPS_CBCR, gcc_rd(GCC_SDCC1_APPS_CBCR) | 1);
+	uint64_t dl = deadline_in(10 * NSEC_PER_MSEC);
+	while (((gcc_rd(GCC_SDCC1_APPS_CBCR) | gcc_rd(GCC_SDCC1_AHB_CBCR)) & CBCR_OFF) && !timed_out(dl)) {
+		delay(1);
+	}
+	se.base_hz = gcc_sdcc1_rate();
+	if ((gcc_rd(GCC_SDCC1_APPS_CBCR) & CBCR_OFF) || !se.base_hz) {
+		diag("sdcc1 clock off: apps 0x%x rate %u", gcc_rd(GCC_SDCC1_APPS_CBCR), se.base_hz);
+		return ENXIO;
+	}
+	return 0;
+}
+
+/* SD clock <= hz from the GCC rate with the SDHCI 10-bit divider. */
+static int
+emmc_set_clock(uint32_t hz)
+{
+	uint32_t n = 0;
+	if (se.base_hz > hz) {
+		n = (se.base_hz + 2 * hz - 1) / (2 * hz);
+		if (n > 1023) {
+			n = 1023;
+		}
 	}
+	wr16(SD_CLK_CTRL, 0);
+	wr16(SD_CLK_CTRL, (uint16_t)(((n & 0xff) << 8) | (((n >> 8) & 3) << 6) | CLK_INT_EN));
+	uint64_t dl = deadline_in(20 * NSEC_PER_MSEC);
+	while (!(rd16(SD_CLK_CTRL) & CLK_INT_STABLE)) {
+		if (timed_out(dl)) {
+			diag("clock not stable 0x%x", rd16(SD_CLK_CTRL));
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	wr16(SD_CLK_CTRL, rd16(SD_CLK_CTRL) | CLK_SD_EN);
+	se.sd_hz = n ? se.base_hz / (2 * n) : se.base_hz;
+	delay(1000);    /* >= 74 card clocks even at 100 kHz */
 	return 0;
 }
 
+/* Full bring-up from a reset host, as Linux sdhci-msm + mmc core would. */
+static int
+emmc_full_init(void)
+{
+	int error;
+	uint32_t r = 0, st;
+
+	if ((error = gcc_sdcc1_on())) {
+		return error;
+	}
+	wr8(SD_SW_RESET, RST_ALL);
+	uint64_t dl = deadline_in(100 * NSEC_PER_MSEC);
+	while (rd8(SD_SW_RESET) & RST_ALL) {
+		if (timed_out(dl)) {
+			diag("RESET_ALL stuck");
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	st = msm_pwr_ack(20 * NSEC_PER_MSEC);
+
+	/* Vendor defaults for <= 100 MHz: POR value, 1.8 V pads, DLL off. */
+	wr32(MSM_VENDOR_SPEC, MSM_VENDOR_SPEC_POR | MSM_IO_PAD_SWITCH_EN | MSM_IO_PAD_SWITCH);
+	wr32(MSM_VENDOR_SPEC3, rd32(MSM_VENDOR_SPEC3) & ~MSM_PWRSAVE_DLL);
+	wr32(MSM_DLL_CONFIG, rd32(MSM_DLL_CONFIG) | MSM_DLL_RST);
+	wr32(MSM_DLL_CONFIG, rd32(MSM_DLL_CONFIG) | MSM_DLL_PDN);
+	if (se.cqhci) {
+		*(volatile uint32_t *)(se.cqhci + 0x08) = 0;    /* CQCFG: engine off */
+	}
+
+	wr32(SD_SIG_ENABLE, 0);
+	wr32(SD_INT_ENABLE, 0x03ff000bu);
+	wr32(SD_INT_STATUS, 0xffffffffu);
+	wr8(SD_TIMEOUT_CTRL, 0xe);
+	wr8(SD_HOST_CTRL, HC_DMA_ADMA2);                /* 1-bit, normal speed */
+	wr8(SD_PWR_CTRL, PWR_ON_1V8);
+	st |= msm_pwr_ack(20 * NSEC_PER_MSEC) << 4;
+	wr16(SD_HOST_CTRL2 + 2, HC2_1V8);
+	st |= msm_pwr_ack(5 * NSEC_PER_MSEC) << 8;
+	if ((error = emmc_set_clock(400000))) {
+		return error;
+	}
+	diag("base %u Hz pwrirq 0x%x pwr 0x%x", se.base_hz, st, rd8(SD_PWR_CTRL));
+
+	se.tmo_ns = 100 * NSEC_PER_MSEC;
+	error = emmc_cmd(0, 0, CMD_RESP_NONE, 0, false, false, NULL);
+	delay(2000);
+	dl = deadline_in(2 * NSEC_PER_SEC);
+	do {
+		/* sector mode, 1.70-1.95 V */
+		error = emmc_cmd(1, 0x40000080u, CMD_RESP_R3, 0, false, false, &r);
+		if (!error && (r & 0x80000000u)) {
+			break;
+		}
+		delay(10000);
+	} while (!timed_out(dl));
+	if (error || !(r & 0x80000000u)) {
+		diag("CMD1 %s ocr 0x%x", error ? "failed" : "busy", r);
+		se.tmo_ns = 0;
+		return error ? error : ETIMEDOUT;
+	}
+	diag("ocr 0x%x", r);
+	error = emmc_cmd(2, 0, CMD_RESP_R2, 0, false, false, NULL);
+	if (!error) {
+		error = emmc_cmd(3, EMMC_RCA << 16, CMD_RESP_R1, 0, false, false, NULL);
+	}
+	se.tmo_ns = 0;
+	if (error) {
+		diag("CMD2/3 failed %d", error);
+		return error;
+	}
+	se.rca = EMMC_RCA;
+	if ((error = emmc_set_clock(25000000))) {
+		return error;
+	}
+	error = emmc_cmd(7, se.rca << 16, CMD_RESP_R1B, 0, false, false, NULL);
+	if (!error) {
+		error = emmc_cmd(13, se.rca << 16, CMD_RESP_R1, 0, false, false, &r);
+	}
+	if (error || R1_STATE(r) != R1_STATE_TRAN) {
+		diag("select failed %d state %u", error, R1_STATE(r));
+		return error ? error : EIO;
+	}
+	printf("GUAMNA eMMC: card up from reset, RCA %u, SD clock %u Hz (base %u)\n",
+	    se.rca, se.sd_hz, se.base_hz);
+	return 0;
+}
