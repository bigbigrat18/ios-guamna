+	    gicr_read32(GICR_IPRIORITYR0 + 16));
+	kprintf("SWEET GICDIAG: daif=0x%llx isr=0x%llx hppir1=0x%llx pmr=0x%llx grpen1=0x%llx sre=0x%llx ctlr=0x%llx cntv_ctl=0x%llx cntv_tval=0x%llx\n",
+	    __builtin_arm_rsr64("DAIF"), __builtin_arm_rsr64("ISR_EL1"), __builtin_arm_rsr64("ICC_HPPIR1_EL1"),
+	    __builtin_arm_rsr64("ICC_PMR_EL1"), __builtin_arm_rsr64("ICC_IGRPEN1_EL1"), __builtin_arm_rsr64("ICC_SRE_EL1"),
+	    __builtin_arm_rsr64("ICC_CTLR_EL1"), __builtin_arm_rsr64("CNTV_CTL_EL0"), __builtin_arm_rsr64("CNTV_TVAL_EL0"));
+}
