--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1864,6 +1864,15 @@ sleh_irq(arm_saved_state_t *state)
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
 	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
 
+#if defined(GUAMNA)
+	/* Bring-up: show the first IRQs the kernel actually takes. */
+	{
+		static uint32_t sweet_irq_logged;
+		if (__atomic_fetch_add(&sweet_irq_logged, 1, __ATOMIC_RELAXED) < 8) {
+			kprintf("SWEET IRQ: intid %u\n", intid);
+		}
+	}
+#endif
 	if (intid >= 1020 && intid <= 1023) {
 		return; /* spurious */
 	}
