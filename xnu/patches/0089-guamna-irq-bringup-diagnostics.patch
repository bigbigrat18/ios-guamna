 class SweetCPU;
 static SweetCPU *sweet_cpus[MAX_CPUS];
@@ -168,7 +172,18 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 				    i, topology->cpus[i].phys_id);
