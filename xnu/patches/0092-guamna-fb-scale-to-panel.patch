+/*
+ * One layer, scaled: every panel pixel whose logical position falls inside
+ * the layer's destination rect takes the nearest source pixel.
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+    int32_t w, int32_t h)
+{
+	uintptr_t src = s->kernelAddress();
+	uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+
+	if (!fBarsCleared) {
+		for (uint32_t y = 0; y < fHeight; y++) {
+			uint32_t *row = (uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+			for (uint32_t x = 0; x < fWidth; x++) {
+				if (fYMap[y] < 0 || fXMap[x] < 0) {
+					row[x] = 0;
+				}
+			}
+		}
+		fBarsCleared = true;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (src == 0 || bpe != 4 || w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    s->memory == NULL ||
+	    (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4 >
+	    s->memory->getLength()) {
+		return;
+	}
+	/* panel column range covered by [dx, dx + w) */
+	uint32_t x0 = fWidth, x1 = 0;
+	for (uint32_t x = 0; x < fWidth; x++) {
+		if (fXMap[x] >= dx && fXMap[x] < dx + w) {
+			if (x < x0) {
+				x0 = x;
+			}
+			x1 = x + 1;
+		}
+	}
+	if (x0 >= x1) {
+		return;
+	}
+	for (uint32_t y = 0; y < fHeight; y++) {
+		int32_t ly = fYMap[y];
+		if (ly < dy || ly >= dy + h) {
+			continue;
+		}
+		const uint32_t *srow = (const uint32_t *)(src + s->offset +
+		    (uint64_t)(sy + ly - dy) * s->bytesPerRow) + sx - dx;
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+		for (uint32_t x = x0; x < x1; x++) {
+			drow[x] = srow[fXMap[x]];
+		}
+	}
+}
