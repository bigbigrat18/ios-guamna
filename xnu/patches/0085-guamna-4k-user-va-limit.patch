diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
index c013288..d2447f4 100644
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -133,9 +133,15 @@ extern int PAGE_SHIFT_CONST;
 
 /* system-wide values */
 #define MACH_VM_MIN_ADDRESS_RAW 0x0ULL
-#if defined(XNU_PLATFORM_MacOSX) || defined(XNU_PLATFORM_DriverKit)
+#if (defined(XNU_PLATFORM_MacOSX) || defined(XNU_PLATFORM_DriverKit)) && !defined(ARM64_BOARD_CONFIG_GUAMNA)
 #define MACH_VM_MAX_ADDRESS_RAW 0x00007FFFFE000000ULL
 #else
+/*
+ * GUAMNA: built as a macOS-platform kernel like SWEET, but with 4K pages the
+ * user VA is only 39 bits (T0SZ 25), and pmap.c requires the commpage
+ * (0xFFFFFC000) to sit above MACH_VM_MAX_ADDRESS. Use the iOS limit, which
+ * is also what the iPhone X userland expects.
+ */
 #define MACH_VM_MAX_ADDRESS_RAW 0x0000000FC0000000ULL
 #endif
 
