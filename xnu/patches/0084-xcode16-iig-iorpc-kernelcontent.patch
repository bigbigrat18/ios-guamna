diff --git a/iokit/DriverKit/IORPC.h b/iokit/DriverKit/IORPC.h
index 3ded78c..2a13ea8 100644
--- a/iokit/DriverKit/IORPC.h
+++ b/iokit/DriverKit/IORPC.h
@@ -224,6 +224,14 @@ struct IORPC {
 	IORPCMessageMach * reply;
 	uint32_t           sendSize;
 	uint32_t           replySize;
+#ifdef KERNEL
+	/*
+	 * Backported from xnu-10002+: Xcode 16's iig generates kernel code that
+	 * sets/reads this. Filled in wherever the kernel builds an IORPC; readers
+	 * fall back to parsing `message` when it is NULL (Xcode 15 iig output).
+	 */
+	IORPCMessage     * kernelContent;
+#endif /* KERNEL */
 };
 typedef struct IORPC IORPC;
 
