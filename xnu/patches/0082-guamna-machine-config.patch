diff --git a/bsd/dev/guamna_stubs.c b/bsd/dev/guamna_stubs.c
new file mode 100644
index 0000000..38a9fa7
--- /dev/null
+++ b/bsd/dev/guamna_stubs.c
@@ -0,0 +1,51 @@
+/*
+ * GUAMNA: link stubs for the sweet (SM7150) hardware drivers that are
+ * compiled out on guamna (sweet_ufs.c, sweet_spmi.c, sweet_keys.c,
+ * sweet_touch.c, sweet_rpmh.c, sweet_usb.c all poke fixed SM7150 MMIO).
+ * Each stub reports "no such device" so the shared callers fall back:
+ *   - IOKitBSDInit rd=ufsroot0     -> panics with a clear message
+ *   - SweetBattery                 -> static 100 % power source
+ *   - serial_console               -> no persistent log until a storage
+ *                                     driver provides one (patch 0083)
+ * Boot guamna with a RAM-disk root (rd=md0) until patch 0083's eMMC
+ * driver is in place.
+ */
+#if defined(ARM64_BOARD_CONFIG_GUAMNA)
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/types.h>
+#include <pexpert/arm64/board_config.h>
+
+int sweet_ufs_rootdev(dev_t *dev);
+int sweet_spmi_init(void);
+int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+
+int
+sweet_ufs_rootdev(__unused dev_t *dev)
+{
+	return ENXIO;
+}
+
+/* TODO guamna: PM6125/PMI632 behind bengal's SPMI arbiter (ADT /guamna-spmi). */
+int
+sweet_spmi_init(void)
+{
+	return ENXIO;
+}
+
+int
+sweet_spmi_read(__unused unsigned sid, __unused unsigned addr, __unused uint8_t *out)
+{
+	return ENXIO;
+}
+
+#if !GUAMNA_EMMC
+/* Replaced by the persistent log in bsd/dev/guamna_emmc.c (patch 0083). */
+void sweet_log_append(const char *c, int size);
+
+void
+sweet_log_append(__unused const char *c, __unused int size)
+{
+}
+#endif /* !GUAMNA_EMMC */
+#endif /* ARM64_BOARD_CONFIG_GUAMNA */
