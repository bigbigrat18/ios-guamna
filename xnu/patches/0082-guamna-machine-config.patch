diff --git a/pexpert/pexpert/arm64/GUAMNA.h b/pexpert/pexpert/arm64/GUAMNA.h
new file mode 100644
index 0000000..950f9c2
--- /dev/null
+++ b/pexpert/pexpert/arm64/GUAMNA.h
@@ -0,0 +1,87 @@
+/*
+ * Board config for the Motorola Moto G Play 2021 ("guamna", Qualcomm SM4250 /
+ * Snapdragon 460, "bengal"): Kryo 240 = 4x Cortex-A73 + 4x Cortex-A53,
+ * ARMv8.0-A. Compared with SWEET (SM7150, ARMv8.2):
+ *
+ *   - 4K pages: the A53 does not implement the 16K translation granule
+ *     (ID_AA64MMFR0_EL1.TGran16 = 0), so __ARM_16K_PG__ stays undefined,
+ *     like BCM2837 (Raspberry Pi 3, also Cortex-A53).
+ *   - No PAN (ARMv8.1), no LSE atomics (ARMv8.1), no RCpc/LDAPR (ARMv8.3),
+ *     no UAO/DPB (ARMv8.2), no PAC. The compiler is pinned to -mcpu=cortex-a53
+ *     in makedefs/MakeInc.def.
+ *   - MPIDR is classic big.LITTLE: Aff1 = cluster, Aff0 = core.
+ *   - Same GICv3 with two security states and the same Qualcomm timer PPI
+ *     numbering as sweet (verify both with tools/fdt-survey.py).
+ *
+ * SWEET stays defined so the board-independent SWEET code (GIC Group 1 IRQ
+ * path, PSCI SMP, platform expert, IOKit services) is shared. GUAMNA marks
+ * the differences. The sweet-only bootstrap framebuffer console (16K tables,
+ * fixed 0x9c000000 splash) is off: SWEET_EARLY_FB is not defined; the kernel
+ * console appears once pe_serial maps /sweet-fbcon from the ADT.
+ */
+
+#ifndef _PEXPERT_ARM64_GUAMNA_H
+#define _PEXPERT_ARM64_GUAMNA_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define SWEET                     1
+#define GUAMNA                    1
+/* 1 once bsd/dev/guamna_emmc.c (patch 0083) provides root storage and the log. */
+#define GUAMNA_EMMC               0
+
+/* 4x A53 (MPIDR 0x000-0x003) + 4x A73 (0x100-0x103), one SMP cluster for XNU. */
+#define SWEET_SMP_MAX_CPUS        8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+/* Not defined on purpose: __ARM_PAN_AVAILABLE__ (ARMv8.1), __ARM_16K_PG__. */
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/* <GIC_PPI 3 ...> in bengal's timer node: INTID 16 + 3. Verify. */
+#define SWEET_VTIMER_INTID        19
+#define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_GUAMNA_H */
